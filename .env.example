APP_ENV=dev
APP_TIMEZONE=Europe/Warsaw
SQLITE_PATH=/data/calico.db
# Pusty = brak CORS (frontend i API sa na tym samym adresie). Kilka originow oddziel przecinkami.
CORS_ORIGIN=
# false = nowe konta tylko przy pierwszym starcie (gdy nie ma zadnego uzytkownika).
ALLOW_SIGNUP=true
# Sesja po odblokowaniu PIN-em (godziny). Pusty SESSION_SECRET = sekret generowany automatycznie i trzymany w bazie.
SESSION_TTL_HOURS=12
SESSION_SECRET=
