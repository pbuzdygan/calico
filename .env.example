# CALICO configuration. Copy to .env and adjust: cp .env.example .env
# Every key is optional - the value shown here is the default used when the key is missing.
# Never commit .env (it may contain SESSION_SECRET).

# User and group id the app runs as inside the container (default 1000:1000). Files in the data volume
# (or in a mounted host directory) are owned by this user. Set them to your host user's ids - check with:
#   id -u   (PUID)   and   id -g   (PGID)
# On start the container changes the owner of /data to PUID:PGID if needed, then drops root rights;
# the app itself never runs as root. 0 (root) is refused.
PUID=1000
PGID=1000

# Time zone that decides what "today" is: which day a meal logged at 00:30 belongs to,
# the default date in forms, and the plan review. Use an IANA name, e.g. Europe/Warsaw, Europe/London, America/New_York.
APP_TIMEZONE=Europe/Warsaw

# Path to the SQLite database inside the container. Both docker-compose files set it to /data/calico.db
# (the calico_data volume), which overrides this value - change it only when running without Docker.
SQLITE_PATH=/data/calico.db

# Who may create new accounts.
#   true  - anyone who can open the app can create an account (handy for a household on a home network).
#   false - only the very first account can be created (on first launch, when there are no users yet);
#           after that POST /api/users returns 403 and the "New user" button is hidden.
# Recommended: false for any instance reachable from the internet. Create all accounts first, then switch to false.
ALLOW_SIGNUP=true

# Login screen.
#   true  - shows a list of all users to pick from (convenient at home).
#   false - asks for the user name instead, so strangers cannot see who has an account. The device remembers
#           the last name entered (never the PIN). Unknown names and wrong PINs get the same answer.
# Recommended: false for any instance reachable from the internet.
SHOW_USER_LIST=true

# Minimum number of digits for new PINs (4-8; the maximum is always 8). Trivial PINs such as 123456 or 111111
# are always rejected. Accounts whose PIN is shorter than this must set a new PIN right after their next sign-in.
# 6 digits plus the built-in rate limits make guessing impractical; 4 is only acceptable on a trusted home network.
PIN_MIN_LENGTH=6

# Reverse proxies trusted to report the real client address in the X-Forwarded-For header
# (comma-separated IP addresses or networks). Used for the per-IP limit on failed sign-ins.
#   default (127.0.0.1,::1) - only a proxy on the same machine outside Docker is trusted; fine without a proxy.
#   behind a reverse proxy (in a container or on the host) - the Docker networks, usually 172.16.0.0/12
#   (connections from the host reach the container through the Docker network gateway).
# Without it, all clients behind the proxy look like one address, so one attacker could block new sign-ins for
# everyone (trusted devices keep working). Never use * when the container port is reachable without the proxy:
# anyone could then fake their address.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# How long you stay signed in after unlocking with your PIN (hours). Closing the browser tab or logging out
# ends the session earlier. Changing the PIN invalidates all existing sessions.
SESSION_TTL_HOURS=12

# Secret key used to sign session tokens (HMAC-SHA256).
#   empty - generated automatically on first start and stored in the database (fine for most installations).
#   set   - use a long random value, e.g. the output of: openssl rand -hex 32
# Changing it signs everyone out. Anyone who knows it can forge sessions - keep it private.
SESSION_SECRET=

# Allowed origins for cross-origin requests (CORS), comma-separated, e.g. https://other.example.com
# Empty = CORS disabled, which is correct when the app and the API are served from the same address (the default setup).
CORS_ORIGIN=

# Interactive API documentation at /docs, /redoc and /openapi.json.
# false (default) - disabled; true - enable for development or API exploration. Keep false on public instances.
API_DOCS=false

# Maximum size of a single request body in bytes (default 4 MiB, enough for the largest CSV import).
# Larger requests are rejected with 413 before being read.
MAX_REQUEST_BYTES=4194304
